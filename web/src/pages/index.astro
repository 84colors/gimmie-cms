  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (function () {
      var form = document.getElementById("email-form");
      if (!form) return;
      var startedAt = document.getElementById("startedAt");
      var submitButton = form.querySelector('[type="submit"]');
      var successMessage = document.querySelector(".success-message");
      var errorMessage = document.querySelector(".error-message");
      if (startedAt) startedAt.value = String(Date.now());
      function showMessage(element, isVisible) {
        if (!element) return;
        element.style.display = isVisible ? "block" : "none";
        element.classList.toggle("is-visible", isVisible);
      }
      showMessage(successMessage, false);
      showMessage(errorMessage, false);
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        form.classList.remove("is-submitted");
        showMessage(successMessage, false);
        showMessage(errorMessage, false);
        var originalValue = submitButton ? submitButton.value : "";
        if (submitButton) {
          submitButton.value = submitButton.getAttribute("data-wait") || "Please wait...";
          submitButton.disabled = true;
        }
        fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" }
        })
          .then(function (response) {
            if (!response.ok) throw new Error("Form submission failed");
            return response.json();
          })
          .then(function () {
            form.reset();
            if (startedAt) startedAt.value = String(Date.now());
            if (window.turnstile) window.turnstile.reset();
            form.classList.add("is-submitted");
            showMessage(successMessage, true);
          })
          .catch(function () {
            showMessage(errorMessage, true);
            if (window.turnstile) window.turnstile.reset();
          })
          .finally(function () {
            if (submitButton) {
              submitButton.value = originalValue;
              submitButton.disabled = false;
            }
          });
      });
    })();
  </script>
