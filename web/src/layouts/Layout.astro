---
import { sanityClient } from 'sanity:client';
import { defineQuery } from 'groq';
import { createDataAttribute } from '@sanity/visual-editing';
import ContactForm from '../components/ContactForm.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
  showContactModal?: boolean;
}

const {
  title,
  description = 'Dublin-based studio creating award-winning explainer videos for healthcare, fintech, edtech and SaaS. Clear, engaging, and made to convert.',
  canonicalPath = Astro.url.pathname,
  structuredData,
  showContactModal = true,
} = Astro.props;

const HOMEPAGE_QUERY = defineQuery(`*[_type == "homepage" && _id == "homepage"][0]`);
const hp = await sanityClient.fetch(HOMEPAGE_QUERY);
const hpAttr = (path: string) =>
  createDataAttribute({ id: 'homepage', type: 'homepage', path }).toString();

const siteUrl = 'https://gimmetheshortversion.com';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const organizationId = `${siteUrl}/#organization`;
const baseStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Gimme the Short Version',
      alternateName: 'GimmeTheShortVersion',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/webclip.png`,
      description: 'A visual communication studio that turns complex healthcare, public-sector, technology, finance and education information into clear, engaging stories.',
      email: hp?.footerEmail ?? 'info@iglooanimations.com',
      telephone: hp?.footerPhone ?? '+353 86 846 8842',
      areaServed: { '@type': 'Country', name: 'Ireland' },
      parentOrganization: { '@type': 'Organization', name: 'Igloo Animations' },
      sameAs: [
        'https://www.instagram.com/iglooanimations/',
        'https://www.youtube.com/gimmetheshortversion',
        'https://uk.linkedin.com/in/trevorcourtney',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Gimme the Short Version',
      publisher: { '@id': organizationId },
      inLanguage: 'en-IE',
    },
  ],
};
const jsonLd = JSON.stringify(structuredData ?? baseStructuredData).replace(/</g, '\\u003c');

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta content={description} name="description">
  <meta content={title} property="og:title">
  <meta content={description} property="og:description">
  <meta property="og:type" content="website">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link rel="canonical" href={canonicalUrl}>
  <script type="application/ld+json" set:html={jsonLd}></script>
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/gimmie-dev.webflow.css" rel="stylesheet" type="text/css">
  <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)">
  <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)">
  <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48">
  <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180">
  <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192">
  <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512">
  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-S8mMMtUKHdzV4UzOqtNU0.js"></script>
  <script is:inline>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7MC4Q6DXNL"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-7MC4Q6DXNL');
  </script>
  <style is:global>
    html.w-mod-js:not(.w-mod-ix3) :is(.faq-desc, .header-h1, .h-list-wrap, .header-text .btn-primary, .navbar-wrap, [data-header]) {
      visibility: hidden !important;
    }
    [data-modal-group-status] { transition: all 0.2s linear; }
    [data-modal-group-status="active"] { opacity: 1; visibility: visible; }
    [data-modal-name][data-modal-status="active"] { display: flex; }
    a { color: inherit; }
    p:last-child { margin-bottom: 0; }
    section {
      padding-left: var(--_spacing---p-global);
      padding-right: var(--_spacing---p-global);
    }
    section > div {
      width: 100%;
      max-width: var(--_primitives---container--container-main);
      margin-left: auto;
      margin-right: auto;
    }
    h1, h2 {
      text-decoration: underline;
      text-decoration-color: var(--_brand---colors--accent);
      text-decoration-thickness: 0.1em;
      text-underline-offset: 6px;
    }
    :root {
      --font-from: 18; --font-to: 20;
      --vw-from: calc(1920 / 100); --vw-to: calc(2400 / 100);
      --coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)));
      --base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16);
    }
    html { font-size: calc(var(--base) * 1rem + var(--coefficient) * 1vw); }
    @media screen and (max-width: 1920px) {
      :root { --font-from: 16; --font-to: 18; --vw-from: calc(1440 / 100); --vw-to: calc(1920 / 100); }
    }
    @media screen and (max-width: 1440px) {
      :root { --font-from: 14; --font-to: 16; --vw-from: calc(479 / 100); --vw-to: calc(1440 / 100); }
    }
    @media screen and (max-width: 479px) {
      :root { --font-from: 12; --font-to: 16; --vw-from: calc(1 / 100); --vw-to: calc(479 / 100); }
    }
    .gsap_split_word-mask { padding-bottom: 0.14em; }
    .menu-button { display: none; }
    @media screen and (max-width: 991px) {
      .navbar { z-index: 1000; }
      .navbar-wrap { position: relative; transform: none !important; }
      .menu-button {
        appearance: none;
        color: var(--_brand---colors--grey-dark);
        background: transparent;
        border: 0;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        display: flex;
      }
      .menu-button .icon { display: block; }
      .nav-menu.is-open {
        width: 100vw;
        padding: 24px var(--_spacing---p-global) 30px;
        border-bottom: 1px solid var(--_brand---colors--grey-light);
        background: #fff;
        color: #252525;
        flex-direction: column;
        display: flex;
        position: fixed;
        top: 68px;
        left: calc((100% - 100vw) / 2);
        z-index: 1001;
        visibility: visible;
        opacity: 1;
      }
      .nav-menu.is-open .nav-link {
        padding-top: 10px;
        padding-bottom: 10px;
        display: inline-block;
      }
    }
  </style>
  <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
</head>
<body>
  <div class="page-wrap">

    <!-- ── Navbar ─────────────────────────────────────────────────── -->
    <div class="navbar">
      <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar-container w-nav">
        <div class="navbar-inner">
          <div class="navbar-wrap">
            <a href="/" class="nav-logo w-nav-brand">
              <img src="/images/logo.svg" loading="eager" alt="Gimme the Short Version" class="image">
            </a>
            <ul id="primary-navigation" role="list" class="nav-menu w-list-unstyled">
              <li><a href="/#about" class="nav-link">About</a></li>
              <li><a href="/#work" class="nav-link">Work</a></li>
              <li><a href="/#process" class="nav-link">Process</a></li>
            </ul>
            <div class="nav-right">
              <a href="/contact" class="btn-primary w-inline-block">
                <div class="btn-text">Get a quote</div>
                <div class="btn-icon w-embed"><svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.8047 5.4801C14.0651 5.21494 14.0651 4.78503 13.8047 4.51988L9.56209 0.198865C9.30173 -0.0662883 8.87962 -0.0662883 8.61927 0.198865C8.35892 0.464018 8.35892 0.893926 8.61927 1.15909L12.3905 4.99998L8.61927 8.84087C8.35892 9.10601 8.35892 9.53592 8.61927 9.80106C8.87962 10.0663 9.30173 10.0663 9.56209 9.80106L13.8047 5.4801ZM0 5.67897H13.3333V4.321H0V5.67897Z" fill="#252525"/></svg></div>
              </a>
              <button type="button" class="menu-button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-navigation" onclick="var m=document.getElementById('mobile-navigation'),o=this.getAttribute('aria-expanded')!=='true';m.classList.toggle('is-open',o);m.style.display=o?'flex':'none';this.setAttribute('aria-expanded',String(o));this.setAttribute('aria-label',o?'Close navigation menu':'Open navigation menu')">
                <div class="icon w-icon-nav-menu"></div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <slot />

    <!-- ── Footer ───────────────────────────────────────────────────── -->
    <footer class="footer-main">
      <div data-wf--spacer--variant="md" class="spacer w-variant-f538d834-7ecf-8af2-40c0-1520852962f4"></div>
      <div class="footer-grid">
        <div class="footer-top-grid">
          <div class="footer_left">
            <div class="footer-top_text-stack">
              <div class="heading-3" data-sanity={hpAttr('footerTagline')}>
                {hp?.footerTagline ?? 'Stop explaining. Start showing. Sit back, relax… Get the short version.'}
              </div>
              <a href="/contact" class="btn-primary w-inline-block">
                <div class="btn-text">Get a quote</div>
                <div class="btn-icon w-embed"><svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.8047 5.4801C14.0651 5.21494 14.0651 4.78503 13.8047 4.51988L9.56209 0.198865C9.30173 -0.0662883 8.87962 -0.0662883 8.61927 0.198865C8.35892 0.464018 8.35892 0.893926 8.61927 1.15909L12.3905 4.99998L8.61927 8.84087C8.35892 9.10601 8.35892 9.53592 8.61927 9.80106C8.87962 10.0663 9.30173 10.0663 9.56209 9.80106L13.8047 5.4801ZM0 5.67897H13.3333V4.321H0V5.67897Z" fill="#252525"/></svg></div>
              </a>
            </div>
          </div>
          <div class="footer_right">
            <div class="footer-contact">
              <div class="heading-5">Get in touch</div>
              <div class="footer-contact-info">
                <div class="footer-links_grid">
                  <div class="footer-link-text" data-sanity={hpAttr('footerPhone')}>{hp?.footerPhone ?? '+353 (0)86 8468842'}</div>
                  <a href={`mailto:${hp?.footerEmail ?? 'info@iglooanimations.com'}?subject=Email%20from%20website`} class="footer-link w-inline-block">
                    <div class="footer-link-text" data-sanity={hpAttr('footerEmail')}>{hp?.footerEmail ?? 'info@iglooanimations.com'}</div>
                  </a>
                  <div class="footer-link">
                    <div class="footer-link-text" data-sanity={hpAttr('footerLocation')}>{hp?.footerLocation ?? 'Dublin & Wicklow'}</div>
                  </div>
                </div>
                <div class="footer-links_grid">
                  <a href="https://www.instagram.com/iglooanimations/" target="_blank" class="footer-link w-inline-block">
                    <div class="footer-link-text">Instagram</div><img src="/images/Frame.svg" loading="lazy" width="16" height="16" alt="" class="footer-link-icon">
                  </a>
                  <a href="http://www.youtube.com/gimmetheshortversion" target="_blank" class="footer-link w-inline-block">
                    <div class="footer-link-text">Youtube</div><img src="/images/Frame.svg" loading="lazy" width="16" height="16" alt="" class="faq-icon">
                  </a>
                  <a href="http://uk.linkedin.com/in/trevorcourtney" target="_blank" class="footer-link w-inline-block">
                    <div class="footer-link-text">LinkedIn</div><img src="/images/Frame.svg" loading="lazy" width="16" height="16" alt="" class="faq-icon">
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="footer-bottom-grid">
          <div class="footer-small-links_grid">
            <div class="text-small">© Copyright GimmieTheShortVersion</div>
            <div class="text-small">Terms</div>
            <div class="text-small">Privacy</div>
          </div>
          <div>
            <a href="https://www.84colors.com" target="_blank" class="link-sm w-inline-block">
              <div class="text-small">Website by 84colors</div>
            </a>
          </div>
        </div>
      </div>
      <div data-wf--spacer--variant="sm" class="spacer w-variant-fce628e4-8018-a217-1152-1a694b33d9e3"></div>
      <img src="/images/scissors.svg" loading="lazy" alt="" class="footer-scissors">
    </footer>

    <!-- ── Modals ───────────────────────────────────────────────────── -->
    {showContactModal && <div data-modal-group-status="not-active" class="modal">
      <div data-hover="" data-modal-close="" class="modal__dark"></div>

      <!-- Contact form modal -->
      <div data-modal-status="not-active" data-modal-name="form" class="modal__card">
        <div class="modal__scroll">
          <div class="modal__content">
            <h2 class="modal__h2">Request a quote</h2>
            <ContactForm id="modal-contact" />
          </div>
        </div>
        <div data-hover="" data-modal-close="" class="modal__btn-close">
          <div class="modal__btn-close-bar"></div>
          <div class="modal__btn-close-bar is--second"></div>
        </div>
      </div>
    </div>}

  </div><!-- /.page-wrap -->

  <!-- ── Scripts ──────────────────────────────────────────────────── -->
  <script is:inline src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a01c0089162c59ecc1a496c" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script is:inline src="/js/webflow.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/SplitText.min.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollToPlugin.min.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/Draggable.min.js"></script>
  <script is:inline src="https://cdn.prod.website-files.com/gsap/3.15.0/CustomEase.min.js"></script>
  <script is:inline>gsap.registerPlugin(ScrollTrigger, SplitText, ScrollToPlugin, Draggable, CustomEase);</script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (function () {
      document.querySelectorAll("[data-contact-form]").forEach(function (container) {
      var form = container.querySelector("form");
      if (!form) return;
      var startedAt = form.querySelector('[name="startedAt"]');
      var submitButton = form.querySelector('[type="submit"]');
      var successMessage = container.querySelector(".success-message");
      var errorMessage = container.querySelector(".error-message");
      if (startedAt) startedAt.value = String(Date.now());
      function showMessage(element, isVisible) {
        if (!element) return;
        element.style.display = isVisible ? "block" : "none";
        element.classList.toggle("is-visible", isVisible);
      }
      showMessage(successMessage, false);
      showMessage(errorMessage, false);
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        form.classList.remove("is-submitted");
        showMessage(successMessage, false);
        showMessage(errorMessage, false);
        var originalValue = submitButton ? submitButton.value : "";
        if (submitButton) {
          submitButton.value = submitButton.getAttribute("data-wait") || "Please wait...";
          submitButton.disabled = true;
        }
        fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" }
        })
          .then(function (response) {
            if (!response.ok) throw new Error("Form submission failed");
            return response.json();
          })
          .then(function () {
            form.reset();
            if (startedAt) startedAt.value = String(Date.now());
            if (window.turnstile) window.turnstile.reset();
            form.classList.add("is-submitted");
            showMessage(successMessage, true);
          })
          .catch(function () {
            showMessage(errorMessage, true);
            if (window.turnstile) window.turnstile.reset();
          })
          .finally(function () {
            if (submitButton) {
              submitButton.value = originalValue;
              submitButton.disabled = false;
            }
          });
      });
      });
    })();
  </script>
  <script is:inline defer src="/js/gimmie-scripts.js"></script>
  <script>
    import { enableVisualEditing } from '@sanity/visual-editing';
    // Only activate overlays when loaded inside the Presentation Tool iframe
    if (window !== window.top) {
      enableVisualEditing();
    }
  </script>
</body>
</html>
