                        <script is:inline>
                            (function () {
                                var wrap = document.currentScript.parentElement.querySelector('.dude-wrap');
                                if (!wrap) return;
                                var svg = wrap.querySelector('.dude-svg');
                                var eyes = svg.querySelector('#eyes');
                                var handL = svg.querySelector('#hand_left');
                                var handR = svg.querySelector('#hand_right');
                                // ---- Tunable settings -------------------------------------------------
                                // Pupil drift in px. Doubled from the previous 3.2.
                                var EYE_RANGE = 6.5;
                                // Page-load wave delay in ms.
                                var LOAD_DELAY = 1000;
                                // Set to false if you'd rather drive the page-load wave purely from
                                // Webflow's Page Load interaction (the .dude-play class). Leaving it
                                // true is harmless even if you also use Webflow — they just both work.
                                var USE_LOAD_TIMER = true;
                                // ----------------------------------------------------------------------
                                var targetX = 0, targetY = 0, curX = 0, curY = 0;
                                var raf = null;
                                // Wave once: add .waving. With a finite animation count the arms
                                // play their cycles and settle; nothing needs to remove the class.
                                function waveBurst() {
                                    handL.classList.add('waving');
                                    handR.classList.add('waving');
                                }
                                // Page-load wave with delay.
                                if (USE_LOAD_TIMER) {
                                    setTimeout(waveBurst, LOAD_DELAY);
                                }
                                function onMove(e) {
                                    var r = svg.getBoundingClientRect();
                                    var cx = r.left + r.width / 2;
                                    var cy = r.top + r.height / 2;
                                    var dx = e.clientX - cx;
                                    var dy = e.clientY - cy;
                                    // --- Eyes: normalized direction, scaled by EYE_RANGE ---
                                    var dist = Math.sqrt(dx * dx + dy * dy) || 1;
                                    var nx = dx / dist;
                                    var ny = dy / dist;
                                    // Looser divisor (was 400) so the eyes reach further sooner.
                                    var mag = Math.min(dist / 260, 1);
                                    targetX = nx * EYE_RANGE * mag;
                                    targetY = ny * EYE_RANGE * mag;
                                    if (!raf) raf = requestAnimationFrame(tick);
                                }
                                function tick() {
                                    // simple lerp toward the target for smooth pupil motion
                                    curX += (targetX - curX) * 0.18;
                                    curY += (targetY - curY) * 0.18;
                                    eyes.style.setProperty('--eye-x', curX.toFixed(2) + 'px');
                                    eyes.style.setProperty('--eye-y', curY.toFixed(2) + 'px');
                                    if (Math.abs(targetX - curX) > 0.05 || Math.abs(targetY - curY) > 0.05) {
                                        raf = requestAnimationFrame(tick);
                                    } else {
                                        raf = null;
                                    }
                                }
                                function onLeave() {
                                    targetX = 0; targetY = 0;
                                    if (!raf) raf = requestAnimationFrame(tick);
                                }
                                window.addEventListener('mousemove', onMove, { passive: true });
                                document.addEventListener('mouseleave', onLeave);
                            })();
                        </script>
