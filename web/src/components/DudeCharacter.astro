                        <style>
                            .dude-wrap {
                                /* Sizing: the SVG scales to fill this wrapper.
       Adjust max-width to taste, or set a fixed width/height. */
                                display: inline-block;
                                width: 100%;
                                max-width: 380px;
                                line-height: 0;
                                /* kills the inline-SVG baseline gap */
                                user-select: none;
                            }

                            .dude-svg {
                                width: 100%;
                                height: auto;
                                overflow: visible;
                                /* lets the arms swing past the viewBox edge */
                            }

                            /* --- Eye tracking ---
     The pupils get nudged via a CSS custom property set by JS. */
                            #eyes {
                                transform: translate(var(--eye-x, 0px), var(--eye-y, 0px));
                                transition: transform 0.12s ease-out;
                                will-change: transform;
                            }

                            /* --- Hand wave ---
     Each arm pivots near its shoulder. The .waving class is added once
     by JS, 1s after page load.
     WEBFLOW TRIGGER: the selectors below ALSO fire when an ancestor
     has the class .dude-play — so a Webflow Page Load interaction that
     adds "dude-play" to the element wrapping this Embed will start the
     wave with no JS timer needed. Both paths are supported; see the
     <script> note to disable the built-in timer if you use Webflow's. */
                            #hand_left,
                            #hand_right {
                                transform-box: fill-box;
                                will-change: transform;
                            }

                            #hand_left {
                                transform-origin: 90% 95%;
                            }

                            /* pivot near left shoulder  */
                            #hand_right {
                                transform-origin: 15% 8%;
                            }

                            /* pivot near right shoulder */
                            /* Left arm: raised to a higher resting position, even before waving. */
                            #hand_left {
                                transform: rotate(18deg);
                            }

                            #hand_right.waving,
                            .dude-play #hand_right {
                                animation: dude-wave-r 0.6s ease-in-out 3;
                                /* "3" = cycles; use "infinite" to loop forever */
                            }

                            #hand_left.waving,
                            .dude-play #hand_left {
                                animation: dude-wave-l 0.7s ease-in-out 3;
                                /* "3" = cycles; use "infinite" to loop forever */
                            }

                            /* Right arm: half the previous swing (was -16deg / 8deg). */
                            @keyframes dude-wave-r {

                                0%,
                                100% {
                                    transform: rotate(0deg);
                                }

                                25% {
                                    transform: rotate(-8deg);
                                }

                                75% {
                                    transform: rotate(4deg);
                                }
                            }

                            /* Left arm: small wave layered on top of the raised 18deg base. */
                            @keyframes dude-wave-l {

                                0%,
                                100% {
                                    transform: rotate(18deg);
                                }

                                25% {
                                    transform: rotate(25deg);
                                }

                                75% {
                                    transform: rotate(13deg);
                                }
                            }

                            /* Respect users who prefer no motion */
                            @media (prefers-reduced-motion: reduce) {

                                #hand_left.waving,
                                #hand_right.waving,
                                .dude-play #hand_left,
                                .dude-play #hand_right {
                                    animation: none;
                                }

                                #eyes {
                                    transition: none;
                                }
                            }

